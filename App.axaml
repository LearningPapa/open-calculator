<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TIDestroyer9000.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>

            <!-- ── Base template shared by all buttons ── -->
            <!--
                FIX: ContentPresenter MUST have Content="{TemplateBinding Content}" and
                ContentTemplate="{TemplateBinding ContentTemplate}" explicitly set in
                Avalonia 11. WPF auto-binds these; Avalonia does not. Without them the
                button renders its background/border but the label text is invisible.
            -->
            <ControlTheme x:Key="BaseBtn" TargetType="Button">
                <Setter Property="Margin"     Value="3"/>
                <Setter Property="FontSize"   Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment"   Value="Center"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="4"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="NumBtn" TargetType="Button"
                          BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="#45475A"/>
                <Setter Property="Foreground" Value="White"/>
            </ControlTheme>

            <ControlTheme x:Key="OpsBtn" TargetType="Button"
                          BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="#F38BA8"/>
                <Setter Property="Foreground" Value="#1E1E2E"/>
            </ControlTheme>

            <ControlTheme x:Key="SciBtn" TargetType="Button"
                          BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="#89B4FA"/>
                <Setter Property="Foreground" Value="#1E1E2E"/>
                <Setter Property="FontSize"   Value="13"/>
            </ControlTheme>

            <ControlTheme x:Key="EqBtn" TargetType="Button"
                          BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="#A6E3A1"/>
                <Setter Property="Foreground" Value="#1E1E2E"/>
            </ControlTheme>

            <ControlTheme x:Key="HelpBtn" TargetType="Button"
                          BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="#6C7086"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize"   Value="13"/>
            </ControlTheme>

        </ResourceDictionary>
    </Application.Resources>
</Application>
